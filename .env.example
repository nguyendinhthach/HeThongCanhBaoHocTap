# Mẫu cấu hình — chép thành file .env (không commit) rồi điền giá trị thật.
# Ý nghĩa từng biến: docs/SPEC.md §12.7

# Cơ sở dữ liệu (bỏ trống thì dùng SQL Server trên máy này, xác thực Windows)
HT_DB_SERVER=localhost
HT_DB_NAME=HT_CANHBAOHOCTAP
# HT_DB_URL=              # điền nếu muốn dùng nguyên chuỗi kết nối SQLAlchemy

# Đăng nhập API (JWT) — HT_JWT_SECRET là chuỗi ngẫu nhiên, ÍT NHẤT 32 ký tự, mỗi máy một chuỗi.
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Bỏ trống thì API tự sinh khoá tạm mỗi lần chạy (khởi động lại là phải đăng nhập lại).
HT_JWT_SECRET=
HT_JWT_HET_HAN_GIO=8

# Gửi email qua Gmail của nhóm — dùng mật khẩu ứng dụng (app password), không dùng mật khẩu thật
HT_SMTP_HOST=smtp.gmail.com
HT_SMTP_PORT=587
HT_SMTP_USER=
HT_SMTP_APP_PASSWORD=
HT_EMAIL_TU=

# Streamlit gọi FastAPI ở đâu
HT_API_URL=http://localhost:8000

# File mốc nhắc theo kế hoạch đào tạo năm học
HT_MOC_HOC_KY=config/moc_hoc_ky.json
